{
  "name": "cloud-functions",
  "description": "Firebase Cloud Functions",
  "dependencies": {
    "@mux/mux-node": "^7.3.3",
    "@onesignal/node-onesignal": "^2.0.1-beta2",
    "axios": "1.6.0",
    "braintree": "^3.6.0",
    "firebase-admin": "^11.11.0",
    "firebase-functions": "^4.4.1",
    "qs": "^6.7.0",
    "razorpay": "^2.8.4",
    "stripe": "^8.0.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.9",
    "eslint": "^6.8.0",
    "eslint-plugin-promise": "^4.2.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "lint": "./node_modules/.bin/eslint --max-warnings=0 .",
    "serve": "firebase -P auto-deal-temp emulators:start --only functions",
    "shell": "firebase -P auto-deal-temp functions:shell",
    "start": "npm run shell",
    "logs": "firebase -P auto-deal-temp functions:log",
    "compile": "cp ../../tsconfig.template.json ./tsconfig-compile.json && tsc --project tsconfig-compile.json",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "engines": {
    "node": "20"
  },
  "private": true
}
