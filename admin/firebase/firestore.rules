rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /chats/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /chats/{parent}/message/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/message/{document} {
      allow read: if true;
    }


    match /admins/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /users/{document} {
      allow create: if true;
      allow read: if true;
      // Роль можно выбрать один раз при первичном заполнении профиля.
      // После этого type и доверенные поля меняются только Cloud Functions.
      allow update: if request.auth != null
        && request.auth.uid == document
        && (!resource.data.keys().hasAll(['profile_filled']) || resource.data.profile_filled == false
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['type']))
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['verification', 'balance', 'carrier_total_earning',
                      'free_response_count']) ;
      allow delete: if false;
    }

    // Аудит-лог верификаций: только чтение админом, запись — сервером.
    match /audit_logs/{document} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }

    // Очередь ручной модерации документов.
    match /verification_queue/{document} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }

    // Счётчики rate limit — только сервер.
    match /rate_limits/{document} {
      allow read, write: if false;
    }

    match /deals/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /reviews/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /auctions/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /transactions/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /complains/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }
  }
}
